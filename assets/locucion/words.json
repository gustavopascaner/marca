  "engine": "eleven",
  "id": "TZvhlMgMw2P4gPSuD8v7",
  "name": "Agustina"
 },
 "beats": [
  {
   "id": "b01",
   "text": "Hola. Esto que estás viendo es la propuesta de identidad visual para tu marca.",
   "s": 0.35,
   "e": 4.95
  },
  {
   "id": "b02",
   "text": "La armamos a partir de lo que nos contaste: a quién le hablás y qué querés transmitir.",
   "s": 5.33,
   "e": 10.65
  },
  {
   "id": "b03",
   "text": "Mirá los colores: un tono principal, uno de acento, y dos fondos, uno claro y uno oscuro.",
   "s": 11.03,
   "e": 18.11
  },
  {
   "id": "b04",
   "text": "Fijate en las tipografías: una para los títulos, que le da personalidad, y otra pensada para leer cómodo.",
   "s": 18.49,
   "e": 25.73
  },
  {
   "id": "b05",
   "text": "Y prestá atención a cómo se mueve todo: las transiciones, los resaltados y los subtítulos.",
   "s": 26.11,
   "e": 32.39
  },
  {
   "id": "b06",
   "text": "Así se van a ver tus videos de ahora en adelante.",
   "s": 32.77,
   "e": 36.01
  },
  {
   "id": "b07",
   "text": "Contanos qué te pareció: qué te gusta, qué cambiarías y si sentís que te representa. Cualquier comentario nos sirve para ajustarla.",
   "s": 36.39,
   "e": 44.59
  }
 ],
